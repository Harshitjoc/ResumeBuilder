{
  "name": "resume-autofill",
  "displayName": "AI Resume Autofill",
  "version": "0.1.0",
  "description": "Import your AI Resume Builder resume and auto-fill job application forms on job boards.",
  "author": "Resume Builder",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://www.linkedin.com/*",
      "https://*.indeed.com/*",
      "https://*.myworkdayjobs.com/*",
      "https://boards.greenhouse.io/*",
      "https://jobs.lever.co/*"
    ],
    "permissions": ["storage", "activeTab", "tabs"]
  }
}
