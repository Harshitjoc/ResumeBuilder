# Supabase (optional for MVP - resume data currently lives in the browser)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Admin token for approving payment requests
ADMIN_TOKEN=admin-dev

# Plan mode (manual = UPI payment approval flow)
PLAN_MODE=manual

# UPI payment details (shown on /api/payments/meta)
UPI_ID=
UPI_PAYEE_NAME=
UPI_PAYMENT_AMOUNT=499
UPI_CURRENCY=INR

# Subscription duration in months after admin approval
SUBSCRIPTION_MONTHS=12

# Enable/disable entitlements (set to 'false' to allow all requests)
ENABLE_ENTITLEMENTS=true

# Daily LLM request limit for free tier
FREE_DAILY_LLM=25