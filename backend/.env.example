# Supabase (REQUIRED for SaaS mode: JWT-verified auth, cloud data, admin panel).
# When SUPABASE_URL + SUPABASE_SERVICE_KEY + SUPABASE_JWT_SECRET are all set,
# the API verifies every request's Supabase JWT and identity headers are ignored.
# With them unset the app runs in browser-local / file-store fallback mode.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Email whose profile is promoted to role=admin at startup (service-role upsert).
ADMIN_EMAIL=

# Cloudflare Turnstile secret for anonymous sign-in abuse protection (optional).
TURNSTILE_SECRET_KEY=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Admin token for approving payment requests
ADMIN_TOKEN=admin-dev

# Plan mode (manual = UPI payment approval flow)
PLAN_MODE=manual

# UPI payment details (shown on /api/payments/meta)
UPI_ID=
UPI_PAYEE_NAME=
UPI_PAYMENT_AMOUNT=499
UPI_CURRENCY=INR

# Subscription duration in months after admin approval
SUBSCRIPTION_MONTHS=12

# Enable/disable entitlements (set to 'false' to allow all requests)
ENABLE_ENTITLEMENTS=true

# Daily LLM request limit for free tier
FREE_DAILY_LLM=25